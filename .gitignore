# Emscripten SDK (bootstrapped by build.sh — reproducible, not vendored)
/emsdk/

# Upstream core checkout (cloned by build.sh at a pinned commit)
/vendor/

# Built core artifacts (reproducible via build.sh)
/web/cores/*.wasm
/web/cores/*.js
/web/cores/*.data
/web/cores/*.bc
/web/cores/PROVENANCE.json

# Deferral-tracking hook state
/docs/plans/.deferrals-seen

# Misc
*.log
.DS_Store
node_modules/
__pycache__/
